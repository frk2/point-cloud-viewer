#!/bin/sh
set -eu
cd "$(dirname "$0")"
for f in server.mjs lib/*.mjs public/*.js test.mjs test-server.mjs; do
  node --check "$f"
done
for f in public/index.html public/style.css public/icon.svg public/samples/roi-world.ply; do
  test -s "$f" || { echo "missing $f" >&2; exit 1; }
done
node --no-warnings --test test.mjs test-server.mjs
